  <ItemGroup>
    <ProjectReference Include="..\RedisVSDoublets\RedisVSDoublets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
